# Browser/API origins allowed by the maintained CORS policy.
ALLOWED_ORIGINS=http://localhost:3000

# Application token used by protected upload/chat/sign endpoints. Set locally; never commit a real token.
APP_API_TOKEN=<set-locally>

# Legacy Aster-compatible API token used only by authenticated integrations that require it.
ASTER_API_TOKEN=<set-locally>

# Cloud Storage bucket consumed by maintained storage/file-service workflows.
BUCKET_NAME=example-bucket

# Gemini API credential. Set locally or in the deployment secret store; never commit a real key.
GEMINI_API_KEY=<set-locally>

# Google Cloud project and region used by maintained deployment/health metadata.
GOOGLE_CLOUD_PROJECT=example-project
GOOGLE_CLOUD_REGION=us-central1

# Local/service port used by the maintained backend surface.
PORT=8080

# Deidentified Aster image-editing defaults retained by the maintained backend utilities.
ASTER_PROMPT_MAX_CHARS=500
ASTER_FILL_GUIDANCE=32
ASTER_EXPAND_PREFILL_BLUR=10
ASTER_EXPAND_MASK_FEATHER=4

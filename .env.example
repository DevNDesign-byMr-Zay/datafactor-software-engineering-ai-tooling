# Comma-separated origins allowed by maintained API/CORS helpers.
ALLOWED_ORIGINS=http://localhost:3000

# Application bearer token. Set locally; never commit a real token.
APP_API_TOKEN=<set-locally>

# Token used by maintained Aster authentication adapters. Set locally; never commit a real token.
ASTER_API_TOKEN=<set-locally>

# Object-storage bucket name used by storage/file-service adapters.
BUCKET_NAME=example-bucket

# Gemini-backed integration credential. Set locally; never commit a real key.
GEMINI_API_KEY=<set-locally>

# Google Cloud project used by deployment/runtime helpers.
GOOGLE_CLOUD_PROJECT=example-project

# Google Cloud region used by deployment/runtime helpers.
GOOGLE_CLOUD_REGION=us-central1

# Local service port.
PORT=8080

# Maintained Aster prompt/runtime controls.
ASTER_PROMPT_MAX_CHARS=500
ASTER_FILL_GUIDANCE=32
ASTER_EXPAND_PREFILL_BLUR=10
ASTER_EXPAND_MASK_FEATHER=4

# CI/release metadata supplied automatically by GitHub Actions.
# These placeholders make every referenced environment name discoverable from a fresh clone.
GITHUB_SHA=
RELEASE_TAG=

# ÆTHERFORGE optional cloud/browser runtime settings.
# These are documentation defaults, not values that need to be exported.
# Do not expose port 4545/4546 publicly; Codespaces authenticates private forwarded ports.
AETHERFORGE_PORT=
# Empty: default loopback binding. Only the trusted Codespaces launcher may enable 0.0.0.0 binding.
AETHERFORGE_CODESPACES_BIND=0
# Set by GitHub Codespaces; false/local by default.
CODESPACES=false
# Codespaces hostname (optional; leave blank for local use).
CODESPACE_NAME=
# Optional local asset directory; if blank, runtime defaults to its app-local store.
AETHERFORGE_DATA_DIR=
# Optional location of server-backed saved project data; never add real project data to Git.
AETHERFORGE_WORKSPACE_DIR=

# ÆTHERFORGE browser acceptance and screenshot tooling, used only in dedicated QA runs.
# The browser runner can target the local companion; never use an unauthenticated public URL.
AETHERFORGE_URL=http://127.0.0.1:4545/
# Optional screenshot output directory.
AETHERFORGE_SCREENSHOT_DIR=artifacts/aetherforge-browser
# Optional absolute executable path to a previously installed Chrome/Chromium binary.
CHROME_PATH=
# Optional installed Playwright module path for browser QA; empty means the runner's standard lookup.
PLAYWRIGHT_MODULE_PATH=

# Optional packaged/desktop browser automation diagnostics. No auto-launch is implied.
AETHERFORGE_ACCEPTANCE_REPORT=
AETHERFORGE_BROWSER_BIN=
# Optional local desktop browser profile directory. Leave unset unless needed.
AETHERFORGE_USER_DATA_DIR=
# System-provided Windows paths (informational only; never override in the shell).
LOCALAPPDATA=
PROGRAMFILES=

# Optional external 500-error notifications for ÆtherForge local/Commercial adapters.
# Disabled by default: both values must be set explicitly by the operator.
# Send only allowlisted route labels/request IDs; do not put credentials in the URL.
# This enables an outbound HTTPS request; leave disabled to keep runtime fully local.
AETHERFORGE_ERROR_REPORTING=0
AETHERFORGE_ERROR_WEBHOOK_URL=

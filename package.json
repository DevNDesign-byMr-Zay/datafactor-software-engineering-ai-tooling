{
  "name": "software-engineering-ai-tooling-corpus",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "Maintained developer-tooling and reusable-library package with provenance-linked historical engineering archives.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./erase-mask": "./src/frontend/erase-mask.js",
    "./backend-config": "./src/reliability/backend-config.js",
    "./progress": "./src/promoted/adaptive-duration-progress.js",
    "./auth": "./src/auth/token-auth.js",
    "./cors": "./src/api/cors-policy.js",
    "./cloud-run": "./src/deployment/cloud-run.js",
    "./cloud-run-reliability": "./src/deployment/cloud-run-reliability.js",
    "./cloud-run-workflow": "./src/deployment/cloud-run-reliable-workflow.js",
    "./cloud-run-release-evidence": "./src/deployment/cloud-run-release-evidence.js",
    "./package-manifest": "./src/bootstrap/package-manifest.js",
    "./application-bootstrap": "./src/bootstrap/application-bootstrap-executor.js",
    "./application-bootstrap-readiness": "./src/bootstrap/application-bootstrap-readiness.js",
    "./application-runtime-acceptance": "./src/runtime/application-runtime-acceptance.js",
    "./holographic-scene-planner": "./src/holographic/scene-planner.js",
    "./holographic-capability-negotiation": "./src/holographic/capability-negotiation.js",
    "./holographic-interaction-normalization": "./src/holographic/interaction-normalization.js",
    "./holographic-readiness-routing": "./src/holographic/readiness-routing.js",
    "./holographic-evidence-envelope": "./src/holographic/evidence-envelope.js",
    "./validated-scene-handoff": "./src/holographic/validated-scene-handoff.js",
    "./runtime-acceptance-receipt": "./src/runtime/runtime-acceptance-receipt.js",
    "./runtime-acceptance-consumer": "./src/runtime/runtime-acceptance-consumer.js",
    "./runtime-acceptance-decision": "./src/runtime/runtime-acceptance-decision.js",
    "./json-logger": "./src/observability/json-logger.js",
    "./error-reporter": "./src/observability/error-reporter.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:js": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/js",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "lint": "eslint --max-warnings=0 src tests/js scripts",
    "format": "prettier --write src tests/js scripts",
    "format:check": "prettier --check src tests/js scripts",
    "demo:sustainability": "node scripts/sustainability-evidence-demo.mjs",
    "check": "npm run verify:surface && npm run verify:release && npm run typecheck && npm run typecheck:strict && npm run lint && npm run format:check && npm run test:coverage && npm run demo:sustainability",
    "setup": "npm ci && python -m pip install -r requirements.lock.txt",
    "typecheck": "tsc -p jsconfig.json",
    "typecheck:strict": "tsc -p jsconfig.strict.json",
    "verify:surface": "node scripts/verify-surface-manifest.mjs",
    "verify:release": "node scripts/verify-release-readiness.mjs"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "developer-tooling",
    "software-engineering",
    "reusable-library",
    "application-tooling",
    "provenance"
  ]
}
